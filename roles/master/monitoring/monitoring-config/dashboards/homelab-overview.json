    {
      "id": 16,
      "type": "bargauge",
      "title": "Availability over selected time range",
      "description": "Share of time the namespace's pods were Ready. 100% = never down. Limited by Prometheus retention.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (namespace) (avg_over_time((max by (namespace, pod) (kube_pod_status_ready{condition=\"true\"}) unless on (namespace, pod) kube_pod_owner{owner_kind=\"Job\"})[$__range:5m]))",
          "legendFormat": "{{namespace}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "max": 1
        },
        "overrides": []
